    <Reference Include="System.Xml" />
    <!--
      Same full-path references as RepxDesigner, and for the same reason: the
      installed DevExpress 20.1 is the version the target ERP is built against,
      so it is the one whose serializer output is worth measuring. Fewer
      assemblies than the designer needs (no XtraEditors, no WinForms),
      because nothing here draws anything.
    -->
    <Reference Include="DevExpress.Data.v20.1">
      <HintPath>C:\Program Files (x86)\DevExpress 20.1\Components\Bin\Framework\DevExpress.Data.v20.1.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Printing.v20.1.Core">
