                <Item2 Ref="53" ControlType="XRTableCell" Name="cellGrandCaption" Text="Grand Total" Weight="261.33" Font="Calibri, 7.7pt, style=Bold" TextAlignment="BottomLeft" Padding="5,5,0,3,100" />
                <Item3 Ref="54" ControlType="XRTableCell" Name="cellGrandBlank2" Weight="165.33" Font="Calibri, 7.7pt, style=Bold" Padding="5,5,0,0,100" />
