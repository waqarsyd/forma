        <Item2 Ref="66" ControlType="XRPageInfo" Name="pageInfo" PageInfo="NumberOfTotal" TextFormatString="Page {0} of {1}" LocationFloat="700, 10.27" SizeF="300, 9.73" Font="Calibri, 5.75pt" ForeColor="255,85,85,85" TextAlignment="MiddleRight" Padding="0,0,0,0,100" />
