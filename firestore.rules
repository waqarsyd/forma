rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Validation Blueprint for SavedReport
    // `hasOnly` as well as `hasAll`: the previous `keys().size() >= 6` accepted
    // the six required fields *plus anything else*, so a modified client could
    // append arbitrary extra fields to a document under its own account. The
    // vault blueprint below already pinned its shape this way; this one did not.
    // handleSaveReport writes exactly these six, so nothing legitimate is lost.
    function isValidSavedReport(data) {
      return data.keys().hasOnly(['id', 'name', 'timestamp', 'messages', 'result', 'userId'])
        && data.keys().hasAll(['id', 'name', 'timestamp', 'messages', 'result', 'userId'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.messages is string
        && data.result is string
        // Bounded to something a clock could plausibly produce, so a client
        // cannot write a timestamp that permanently pins a report to the top of
        // the list. Firestore's own 1 MiB document ceiling is what bounds
        // `messages`/`result`; see the note in CLAUDE.md about image payloads.
        && data.timestamp is number && data.timestamp > 0 && data.timestamp < 4102444800000
        && data.userId == request.auth.uid;
    }

    // Validation Blueprint for one stored revision of a report.
    //
    // Same six-field, flat-string shape as the report above, and pinned the
    // same way with hasOnly + hasAll so this path cannot be repurposed as
    // general storage under an account.
    //
    // `reportId` is carried on the document as well as being in its path. It is
    // not redundant: the rule below pins it to the {reportId} wildcard, so a
    // client cannot write a version that claims to belong to a different report
    // than the one it is filed under. The report document pins `id` to its own
    // document id for the same reason.
    function isValidReportVersion(data, reportId) {
      return data.keys().hasOnly(['id', 'reportId', 'label', 'timestamp', 'snapshot', 'userId'])
        && data.keys().hasAll(['id', 'reportId', 'label', 'timestamp', 'snapshot', 'userId'])
        && data.id is string && data.id.size() <= 128
        && data.reportId == reportId
        && data.label is string && data.label.size() <= 256
        && data.snapshot is string
        // Same bound as the report's timestamp, and for the same reason: a
        // far-future value would pin one version to the top of the history.
        && data.timestamp is number && data.timestamp > 0 && data.timestamp < 4102444800000
        && data.userId == request.auth.uid;
    }

    // Validation Blueprint for the encrypted Gemini key vault.
    //
    // This document holds AES-GCM ciphertext produced in the user's browser by
    // src/services/keyVault.ts, plus the public PBKDF2/AES parameters needed to
    // derive the same key again. The passphrase never leaves the browser, so a
    // plaintext API key must never appear here — rules cannot prove a blob is
    // encrypted, but they can pin the shape and bound the size so this path
    // cannot be repurposed as general storage.
    function isValidKeyVault(data) {
      return data.keys().hasOnly(['v', 'ciphertext', 'iv', 'salt', 'iterations'])
        && data.keys().hasAll(['v', 'ciphertext', 'iv', 'salt', 'iterations'])
        && data.v is number
        && data.ciphertext is string && data.ciphertext.size() > 0 && data.ciphertext.size() <= 2048
        && data.iv is string && data.iv.size() <= 64
        && data.salt is string && data.salt.size() <= 64
        // Reject a weakened iteration count written by a tampered client.
        //
        // 310,000 is OWASP's 2023 floor for PBKDF2-HMAC-SHA256 and what
        // keyVault.ts uses. This said 100,000 until 2026-08-27, which is a
        // third of the number the code itself calls a floor — so the rule
        // existing to stop a weakening stopped it at the wrong place.
        //
        // Safe to raise: each record stores the count it was written with and
        // decryption honours that value, so existing records keep opening.
        // Only new writes are constrained.
        && data.iterations is number && data.iterations >= 310000;
    }

    // Split by operation on purpose. The previous single `allow read, write`
    // ended in `request.method == 'delete' || isValidKeyVault(incoming())`, and
    // `incoming()` is `request.resource.data` — which exists only on writes.
    // On a read the expression dereferenced a null `request.resource`, the rule
    // errored, and the read was denied. App.tsx does exactly one thing with this
    // document on load: `getDoc`. So the stored-key check always failed, was
    // swallowed into a console.warn, and the UI reported "no stored key" even
    // when one existed — making a synced key impossible to restore.
    //
    // No `list` clause: the app only ever addresses the single `geminiKey` doc,
    // so there is no reason to permit enumerating the collection.
    match /users/{userId}/vault/{vaultId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && isValidId(vaultId)
        && userId == request.auth.uid;

      allow delete: if isSignedIn()
        && isValidId(userId)
        && isValidId(vaultId)
        && userId == request.auth.uid;

      allow create, update: if isSignedIn()
        && isValidId(userId)
        && isValidId(vaultId)
        && userId == request.auth.uid
        && isValidKeyVault(incoming());
    }

    match /users/{userId}/reports/{reportId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      
      allow list: if isSignedIn() && userId == request.auth.uid;
      
      // A new project raises the account's count in the same batch, up to
      // 1,000 (2026-11-11, the full audit's SA-01; `usage` below).
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidId(reportId)
        && userId == request.auth.uid
        && isValidSavedReport(incoming())
        && incoming().id == reportId
        && getAfter(usagePath(userId)).data.get('reports', 0) == reportsCounted(userId) + 1
        && getAfter(usagePath(userId)).data.get('report', '') == reportId;

      allow update: if isSignedIn() 
        && isValidId(userId)
        && isValidId(reportId)
        && userId == request.auth.uid
        && existing().userId == request.auth.uid
        && isValidSavedReport(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id;

      // While the count is above zero the same batch lowers it by one; a
      // project saved before the count existed leaves it at zero, and goes
      // without one, as a share does.
      allow delete: if isSignedIn()
        && isValidId(userId)
        && isValidId(reportId)
        && userId == request.auth.uid
        && existing().userId == request.auth.uid
        && (reportsCounted(userId) == 0
          || (getAfter(usagePath(userId)).data.get('reports', 0) == reportsCounted(userId) - 1
            && getAfter(usagePath(userId)).data.get('report', '') == reportId));
    }

    // The account's index of its projects (2026-11-08, site audit item 63):
    // what the list shows and searches, so the list no longer downloads every
    // project in full. Pinned like the report it describes, and owner-only.
    function isValidReportIndex(data) {
      return data.keys().hasOnly(['id', 'name', 'timestamp', 'search', 'notes', 'userId'])
        && data.keys().hasAll(['id', 'name', 'timestamp', 'search', 'notes', 'userId'])
        && data.notes is int && data.notes >= 0
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.search is string && data.search.size() <= 4000
        && data.timestamp is number && data.timestamp > 0 && data.timestamp < 4102444800000
        && data.userId == request.auth.uid;
    }

    match /users/{userId}/reportIndex/{reportId} {
      allow read: if isSignedIn() && userId == request.auth.uid;

      allow create, update: if isSignedIn()
        && isValidId(userId)
        && isValidId(reportId)
        && userId == request.auth.uid
        && isValidReportIndex(incoming())
        && incoming().id == reportId;

      allow delete: if isSignedIn()
        && isValidId(reportId)
        && userId == request.auth.uid;
    }

    // Validation Blueprint for a shared report (2026-11-06, the Share dialog).
    //
    // A COPY, written by its owner, never their saved project: users/{uid}
    // stays owner-only whatever is shared. Pinned with hasOnly + hasAll like
    // the others, so the one collection anyone may read cannot be repurposed
    // as storage. `id` is the document id, `ownerId` the writer, and
    // `reportId` the project it was shared from (its own owner-scoped id).
    //
    // No `emails` since 2026-11-11 (the full audit, SE-04): this document is
    // what a link share hands to anyone, so the invitees' addresses went to
    // everyone the link reached. They live in the share's access list below,
    // which only its owner reads. A share written before then keeps its
    // `emails` until its owner next writes it, which replaces the document
    // whole in this shape (Owner decision 7: no migration script).
    function isValidShare(data, shareId) {
      return data.keys().hasOnly(['id', 'ownerId', 'reportId', 'name', 'result', 'access', 'timestamp'])
        && data.keys().hasAll(['id', 'ownerId', 'reportId', 'name', 'result', 'access', 'timestamp'])
        && data.id == shareId
        && data.ownerId == request.auth.uid
        && isValidId(data.reportId)
        && data.name is string && data.name.size() <= 256
        && data.result is string && data.result.size() <= 1000000
        && data.access in ['restricted', 'link']
        && data.timestamp is number && data.timestamp > 0 && data.timestamp < 4102444800000;
    }

    // A share's access list, `shares/{id}/acl/emails`: `ownerId` and `list`,
    // the people invited, lower-cased by the client. Rules cannot walk a
    // list, so only its length is bounded.
    function shareAclPath(shareId) {
      return /databases/$(database)/documents/shares/$(shareId)/acl/emails;
    }
    function isValidShareAcl(data) {
      return data.keys().hasOnly(['ownerId', 'list'])
        && data.keys().hasAll(['ownerId', 'list'])
        && data.ownerId == request.auth.uid
        && data.list is list && data.list.size() <= 50;
    }

    // Whether the caller's VERIFIED address is one the share was opened to:
    // in its access list, or in the `emails` a share from before the list
    // still carries. The verification is load-bearing: an email-and-password
    // account can be created with any address unverified, so without it
    // anyone could read a restricted share by signing up as an invitee.
    function isInvited(shareId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (('emails' in resource.data && request.auth.token.email.lower() in resource.data.emails)
          || (exists(shareAclPath(shareId))
            && request.auth.token.email.lower() in get(shareAclPath(shareId)).data.list));
    }

    // Shared reports. Read by its owner; by anyone at all when its access is
    // 'link' (the random id is the secret, as "anyone with the link" says);
    // and otherwise only by an invitee, as `isInvited` says.
    //
    // `list` only for the owner's own, which the app needs to find the share
    // of a project and to delete a project's or an account's shares; the
    // query must say ownerId == the caller, or Firestore refuses it.
    match /shares/{shareId} {
      allow get: if isValidId(shareId) && (
        resource.data.access == 'link'
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || isInvited(shareId)
      );

      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Who may put a report on this domain for others to read (2026-11-08,
      // site audit item 57). Anyone with an account could, unverified, in any
      // number, naming any report id. Now: a verified address, a project the
      // account really has, and one more on the account's share count, which
      // the same batch must raise (`users/{uid}/meta/quota` below), up to 100.
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && isValidId(shareId)
        && isValidShare(incoming(), shareId)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/reports/$(incoming().reportId))
        && getAfter(quotaPath(request.auth.uid)).data.shares == sharesCounted(request.auth.uid) + 1
        && getAfter(quotaPath(request.auth.uid)).data.last == shareId
        && getAfter(quotaPath(request.auth.uid)).data.shares <= 100;

      // Changing who may read it needs a verified address too (item 57).
      allow update: if isSignedIn()
        && request.auth.token.email_verified == true
        && isValidId(shareId)
        && existing().ownerId == request.auth.uid
        && isValidShare(incoming(), shareId)
        && incoming().reportId == existing().reportId;

      // Stopping a share is always the owner's, verified or not. While the
      // count is above zero the same batch lowers it by one; a share made
      // before the count existed (2026-11-08) leaves it at zero, so it goes
      // without one.
      allow delete: if isSignedIn()
        && isValidId(shareId)
        && existing().ownerId == request.auth.uid
        && (sharesCounted(request.auth.uid) == 0
          || (getAfter(quotaPath(request.auth.uid)).data.shares == sharesCounted(request.auth.uid) - 1
            && getAfter(quotaPath(request.auth.uid)).data.last == shareId));
    }

    // A share's access list (2026-11-11, SE-04): the owner's alone, never
    // read by an invitee or a link holder; the rules read it for them. Written
    // only for a share the caller owns once the batch lands, with a verified
    // address as changing a share needs. Reading a list not written yet is
    // the owner's too, so the dialog can open a share made before lists
    // existed. Deleted by its owner, or when it was never there, which is how
    // deleting such a share deletes "its list" in the same batch.
    match /shares/{shareId}/acl/{aclId} {
      allow get: if isSignedIn() && isValidId(shareId) && aclId == 'emails'
        && ((resource == null && exists(sharePath(shareId)) && get(sharePath(shareId)).data.ownerId == request.auth.uid)
          || (resource != null && resource.data.ownerId == request.auth.uid));

      allow create, update: if isSignedIn()
        && request.auth.token.email_verified == true
        && isValidId(shareId)
        && aclId == 'emails'
        && isValidShareAcl(incoming())
        && existsAfter(sharePath(shareId))
        && getAfter(sharePath(shareId)).data.ownerId == request.auth.uid;

      allow delete: if isSignedIn() && aclId == 'emails'
        && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // An account's share count (2026-11-08, site audit item 57): `shares`, and
    // `last`, the share the latest change was for. It moves only by one, and
    // only in the batch that creates or deletes that share, so it cannot be
    // lowered to make room or raised to block anyone; deleted only at zero,
    // which is how account deletion leaves it.
    function quotaPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/meta/quota;
    }
    function sharePath(id) {
      return /databases/$(database)/documents/shares/$(id);
    }
    function sharesCounted(uid) {
      return exists(quotaPath(uid)) ? get(quotaPath(uid)).data.shares : 0;
    }
    function isValidQuota(data) {
      return data.keys().hasOnly(['shares', 'last'])
        && data.keys().hasAll(['shares', 'last'])
        && data.shares is int && data.shares >= 0
        && isValidId(data.last);
    }
    function shareAdded(data) {
      return !exists(sharePath(data.last))
        && existsAfter(sharePath(data.last))
        && getAfter(sharePath(data.last)).data.ownerId == request.auth.uid;
    }
    function shareRemoved(data) {
      return exists(sharePath(data.last))
        && !existsAfter(sharePath(data.last))
        && get(sharePath(data.last)).data.ownerId == request.auth.uid;
    }

    // What an account may write (2026-11-11, the full audit's SA-01, SE-08 and
    // LM-15), `users/{uid}/meta/usage`, moved in the same batch as each write
    // it counts, as the share count is: `reports` and `report`, the projects
    // held (at most 1,000) and the last one added or removed; `events`,
    // `eventDay`, `eventAt` and `event`, the learning events of the server's
    // day (at most 300, two seconds apart) and the last one. Until then one
    // account could write without bound into a free plan every visitor shares.
    function usagePath(uid) {
      return /databases/$(database)/documents/users/$(uid)/meta/usage;
    }
    function reportPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/reports/$(id);
    }
    function learningPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/learning/$(id);
    }
    function reportsCounted(uid) {
      return exists(usagePath(uid)) ? get(usagePath(uid)).data.get('reports', 0) : 0;
    }
    // The server's day as YYYY-MM-DD, what a learning event's `day` and the
    // date of its `at` must be (LM-26): the client cannot choose its time.
    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }
    function serverDay() {
      return string(request.time.year()) + '-' + pad2(request.time.month()) + '-' + pad2(request.time.day());
    }
    function isValidUsage(data) {
      return data.keys().hasOnly(['reports', 'report', 'events', 'eventDay', 'eventAt', 'event']);
    }
    function reportAdded(before, after, uid) {
      return after.diff(before).affectedKeys().hasOnly(['reports', 'report'])
        && after.reports is int
        && after.reports == before.get('reports', 0) + 1
        && after.reports <= 1000
        && isValidId(after.report)
        && !exists(reportPath(uid, after.report))
        && existsAfter(reportPath(uid, after.report));
    }
    function reportRemoved(before, after, uid) {
      return after.diff(before).affectedKeys().hasOnly(['reports', 'report'])
        && after.reports is int
        && after.reports == before.get('reports', 0) - 1
        && after.reports >= 0
        && isValidId(after.report)
        && exists(reportPath(uid, after.report))
        && !existsAfter(reportPath(uid, after.report));
    }
    function eventAdded(before, after, uid) {
      return after.diff(before).affectedKeys().hasOnly(['events', 'eventDay', 'eventAt', 'event'])
        && after.eventAt == request.time
        && after.eventDay == serverDay()
        && after.events is int
        && after.events <= 300
        && (before.get('eventDay', '') == serverDay()
          ? (after.events == before.events + 1 && request.time >= before.eventAt + duration.value(2, 's'))
          : after.events == 1)
        && isValidId(after.event)
        && !exists(learningPath(uid, after.event))
        && existsAfter(learningPath(uid, after.event));
    }
    // The two ids taken out at zero projects (2026-11-11), as deleting the
    // account does before it deletes the counts: on a day an event was sent
    // the counts must stay, and the ids need not.
    function idsCleared(before, after) {
      return before.get('reports', 0) == 0
        && after.diff(before).affectedKeys().hasOnly(['report', 'event'])
        && !after.keys().hasAny(['report', 'event']);
    }

    match /users/{userId}/meta/{metaId} {
      allow get: if isSignedIn() && userId == request.auth.uid && metaId == 'quota';

      allow create: if isSignedIn() && userId == request.auth.uid && metaId == 'quota'
        && isValidQuota(incoming())
        && incoming().shares == 1
        && shareAdded(incoming());

      allow update: if isSignedIn() && userId == request.auth.uid && metaId == 'quota'
        && isValidQuota(incoming())
        && ((incoming().shares == existing().shares + 1 && shareAdded(incoming()))
          || (incoming().shares == existing().shares - 1 && shareRemoved(incoming())));

      // At zero, or absent (account deletion removes it whether or not the
      // account ever shared anything).
      allow delete: if isSignedIn() && userId == request.auth.uid && metaId == 'quota'
        && (resource == null || existing().shares == 0);

      // The account's two learning switches (2026-11-11, the full audit, LM-01
      // and SA-13), `users/{uid}/meta/learning`, so they follow the person to
      // every device rather than staying in one browser for whoever signs in
      // there next. Two booleans and nothing else, read and written by the
      // owner alone; deleted with the account.
      allow get, delete: if isSignedIn() && userId == request.auth.uid && metaId == 'learning';
      allow create, update: if isSignedIn() && userId == request.auth.uid && metaId == 'learning'
        && incoming().keys().hasOnly(['structure', 'full'])
        && incoming().keys().hasAll(['structure', 'full'])
        && incoming().structure is bool
        && incoming().full is bool;

      // The write counts (SA-01): read by the owner, moved only by a write
      // they count (or its two ids cleared at zero projects), and deleted only
      // at zero projects on a day with no learning event sent, so deleting
      // them cannot restart a day's count.
      allow get: if isSignedIn() && userId == request.auth.uid && metaId == 'usage';
      allow create, update: if isSignedIn() && userId == request.auth.uid && metaId == 'usage'
        && isValidUsage(incoming())
        && (reportAdded(resource == null ? {} : resource.data, incoming(), userId)
          || reportRemoved(resource == null ? {} : resource.data, incoming(), userId)
          || eventAdded(resource == null ? {} : resource.data, incoming(), userId)
          || (resource != null && idsCleared(resource.data, incoming())));
      allow delete: if isSignedIn() && userId == request.auth.uid && metaId == 'usage'
        && (resource == null
          || (resource.data.get('reports', 0) == 0 && resource.data.get('eventDay', '') != serverDay()));
    }

    // What a person lets Forma learn from (2026-11-10, the full audit;
    // lib/learning.ts): one event per generated report, edit, translation or
    // rating, in the shape the app writes and nothing else. The account owns
    // its collection: it may list and delete it (Settings shows and clears
    // it, deleting the account removes it), never change an event. The owner
    // reads every account's events with a service account, on their own PC.
    // Sizes keep a document well under Firestore's 1 MiB: a skeleton is JSON
    // of structure only, a full report is there only on the opt-in tier.
    //
    // Event v2 (2026-11-11, the full audit's LM-10a to LM-13, LM-25, LM-26 and
    // LM-12): every list below is lib/learning.ts's, and learning.test.ts holds
    // the two together. `day` is the server's day and `at` a time on it, so a
    // made-up time cannot reach the owner's pull; a rating, a kept report and
    // an undo name the event they are about in `ref`.
    function isValidLearning(data, id, uid) {
      return data.keys().hasOnly(['id', 'userId', 'at', 'day', 'kind', 'source', 'request', 'ai', 'skeleton', 'ops', 'roles', 'errors', 'warnings', 'rating', 'ref', 'how', 'draft', 'ms', 'project', 'distance', 'dropped', 'full', 'prompt'])
        && data.keys().hasAll(['id', 'userId', 'at', 'day', 'kind', 'source', 'request', 'ai', 'skeleton', 'ops', 'roles', 'errors', 'warnings', 'rating', 'ref', 'how', 'draft', 'ms', 'project', 'distance', 'dropped', 'full', 'prompt'])
        && data.id == id
        && data.userId == uid
        && data.day == serverDay()
        && data.at is string && data.at.size() <= 40
        && data.at.matches(serverDay() + 'T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z')
        && data.kind in ['generation', 'edit', 'translate', 'rating', 'kept', 'undo']
        && data.source in ['image', 'pdf', 'repx', 'words', 'database', 'mixed', 'none']
        && data.request in ['new', 'redesign', 'edit', 'batch', 'none']
        && data.ai in ['gemini', 'local', 'openrouter', 'forma', 'mock', 'none']
        && data.skeleton is string && data.skeleton.size() <= 80000
        && (data.skeleton == '' || data.kind in ['generation', 'kept'])
        && data.ops is list && data.ops.size() <= 40
        && data.roles is list && data.roles.size() == data.ops.size()
        && data.errors is int && data.errors >= 0
        && data.warnings is int && data.warnings >= 0
        && data.rating in ['', 'good', 'bad']
        && (data.rating == '' || data.kind == 'rating')
        && data.ref is string && data.ref.size() <= 64
        && (data.ref == '' || isValidId(data.ref))
        && data.how in ['', 'repx', 'pdf', 'xlsx', 'csv', 'docx', 'rtf', 'html', 'png', 'designer', 'save']
        && data.draft in ['', 'reader', 'ocr', 'offline']
        && data.ms is int && data.ms >= 0
        && data.project is string && (data.project == '' || data.project.matches('[0-9a-f]{12}'))
        && data.distance is number && data.distance >= -1
        && data.dropped in ['', 'skeleton', 'full']
        && data.full is string && data.full.size() <= 700000
        && data.prompt is string && data.prompt.size() <= 4000;
    }
    match /users/{userId}/learning/{eventId} {
      allow get, list: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;

      // A verified address (SA-01: an unverified account is anyone's to
      // make), and the day's count raised in the same batch (`usage`).
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidId(eventId)
        && isValidLearning(incoming(), eventId, userId)
        && getAfter(usagePath(userId)).data.get('event', '') == eventId
        && getAfter(usagePath(userId)).data.get('eventAt', null) == request.time;

      allow delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
    }

    // A report's revision history.
    //
    // Its own subcollection because a saved report is size-budgeted at 900 kB
    // and one snapshot -- markdown, layout and REPX -- runs 50-200 kB; ten
    // inline would break that several times over. Each version is its own
    // document with its own 1 MiB ceiling, and the report document's shape and
    // budget are untouched.
    //
    // `list` is allowed here, unlike the vault: loading a report's history means
    // enumerating this collection, and deleting a report means enumerating it
    // to remove what Firestore will not remove on its own. Scoped to the owner,
    // as everything under users/{uid} is.
    //
    // Note the parent report document is NOT required to exist. Firestore
    // subcollections are independent of their parent, and requiring existence
    // via get() would cost a read on every write to buy nothing: the path is
    // already owner-scoped, and a version under a report that has gone is
    // deleted by `deleteReportAndVersions`, not prevented by a rule.
    match /users/{userId}/reports/{reportId}/versions/{versionId} {
      allow get, list: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid;

      allow create, update: if isSignedIn()
        && isValidId(userId)
        && isValidId(reportId)
        && isValidId(versionId)
        && userId == request.auth.uid
        && isValidReportVersion(incoming(), reportId)
        && incoming().id == versionId;

      allow delete: if isSignedIn()
        && isValidId(userId)
        && isValidId(reportId)
        && isValidId(versionId)
        && userId == request.auth.uid;
    }
  }
}
